{
  "name": "@rhythmjs/schedule",
  "version": "0.0.3",
  "description": "Task scheduling for Rhythm on Bun: cron, interval, and timeout jobs on a kernel module, with an in-process scheduler and a dependency-free, timezone-aware cron engine.",
  "keywords": [
    "bun",
    "cron",
    "interval",
    "jobs",
    "rhythm",
    "scheduler",
    "task-scheduling"
  ],
  "homepage": "https://rhythm.js.org/schedule",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/tasks.git",
    "directory": "packages/schedule"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/schedule.d.ts",
      "default": "./dist/schedule.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./cron": {
      "types": "./dist/cron.d.ts",
      "default": "./dist/cron.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "default": "./dist/scheduler.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/schedule.ts src/types.ts src/cron.ts src/scheduler.ts --outdir dist --root src --format esm --target bun --packages external --splitting && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@rhythmjs/rhythm": "^0.0.14"
  },
  "peerDependencies": {
    "@rhythmjs/rhythm": ">=0.0.14"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
